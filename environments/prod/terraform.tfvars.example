organization_name  = "acme-enterprise"
environment        = "prod"
aws_region         = "af-south-1"
owner              = "Platform Engineering"
cost_center        = "PLAT001"
kms_key_arn        = ""   # from landing zone output
vpc_id             = ""
private_subnet_ids = []
intra_subnet_ids   = []
public_subnet_ids  = []
cluster_name       = "platform"
kubernetes_version = "1.29"
cluster_endpoint_private_access      = true
cluster_endpoint_public_access       = false
cluster_endpoint_public_access_cidrs = []
node_ami_type      = "AL2_x86_64"
node_groups = {
  general = {
    instance_types = ["m6i.large"]
    capacity_type  = "ON_DEMAND"
    desired_size   = 3; min_size = 3; max_size = 10
    disk_size_gb   = 50
    labels         = { role = "general" }
    taints         = []
  }
  compute = {
    instance_types = ["c6i.xlarge"]
    capacity_type  = "ON_DEMAND"
    desired_size   = 2; min_size = 0; max_size = 20
    disk_size_gb   = 50
    labels         = { role = "compute" }
    taints         = [{ key = "compute", value = "true", effect = "NO_SCHEDULE" }]
  }
}
enable_aws_load_balancer_controller = true
enable_cluster_autoscaler           = true
enable_metrics_server               = true
enable_external_secrets             = true
enable_falco                        = true
enable_container_insights           = true
log_retention_days                  = 90
application_namespaces              = ["app", "data", "monitoring", "security"]
pod_security_standards = { enforce = "restricted", audit = "restricted", warn = "restricted" }
alarm_sns_topic_arn    = ""   # from SOC module output

# ============================================================
# AWS Secure EKS Platform — Example tfvars
# ============================================================
# cp terraform.tfvars.example environments/prod/terraform.tfvars
# NEVER commit terraform.tfvars to git.
# ============================================================

organization_name = "acme-enterprise"
aws_region        = "af-south-1"
dr_region         = "eu-west-1"
environment       = "prod"
owner             = "Platform Engineering"
cost_center       = "PLAT001"

# ---- From aws-enterprise-landing-zone outputs --------------
kms_key_arn = ""   # terraform output kms_cloudtrail_key_arn

# ---- From terraform-enterprise-module-library vpc outputs --
vpc_id             = ""   # module.vpc.vpc_id
private_subnet_ids = []   # module.vpc.private_subnet_ids
intra_subnet_ids   = []   # module.vpc.intra_subnet_ids
public_subnet_ids  = []   # module.vpc.public_subnet_ids

# ---- From aws-devsecops-pipeline outputs -------------------
ecr_repository_urls = {}  # terraform output ecr_repository_urls
pipeline_role_arn   = ""  # terraform output codebuild_role_arn

# ---- EKS Cluster -------------------------------------------
cluster_name       = "platform"
kubernetes_version = "1.36"

cluster_endpoint_private_access      = true
cluster_endpoint_public_access       = false   # Never true in prod
cluster_endpoint_public_access_cidrs = []

cluster_log_types = ["api", "audit", "authenticator", "controllerManager", "scheduler"]

# ---- Node Groups -------------------------------------------
node_ami_type = "AL2_x86_64"

node_groups = {
  general = {
    instance_types = ["m6i.large"]
    capacity_type  = "ON_DEMAND"
    desired_size   = 3
    min_size       = 3
    max_size       = 10
    disk_size_gb   = 50
    labels         = { "role" = "general" }
    taints         = []
  }
  compute = {
    instance_types = ["c6i.xlarge"]
    capacity_type  = "ON_DEMAND"
    desired_size   = 2
    min_size       = 0
    max_size       = 20
    disk_size_gb   = 50
    labels         = { "role" = "compute" }
    taints         = [{ key = "compute", value = "true", effect = "NO_SCHEDULE" }]
  }
}

# ---- Helm Add-ons ------------------------------------------
enable_aws_load_balancer_controller = true
enable_cluster_autoscaler           = true
enable_metrics_server               = true
enable_external_secrets             = true
enable_falco                        = true
enable_karpenter                    = false

# ---- Security ----------------------------------------------
pod_security_standards = {
  enforce = "restricted"
  audit   = "restricted"
  warn    = "restricted"
}

application_namespaces = ["app", "data", "monitoring", "security"]

# ---- Monitoring --------------------------------------------
enable_container_insights = true
log_retention_days        = 90

# ---- ALB TLS -----------------------------------------------
acm_certificate_arn = ""   # arn:aws:acm:<region>:<account>:certificate/<id>

# ---- Alerts (from SOC module) ------------------------------
alarm_sns_topic_arn = ""   # terraform output critical_alerts_topic_arn
